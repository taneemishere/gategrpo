+import re
+
+
+def extract_links(text: str) -> list[dict]:
+    """Return the inline Markdown links in order of appearance."""
+    return [
+        {"text": link_text, "url": url}
+        for link_text, url in re.findall(r"\[([^\]]*)\]\(([^)]*)\)", text)
+    ]
+    ]
